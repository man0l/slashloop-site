# Copy to .env.local for `npm run dev`. Vite only exposes vars prefixed
# VITE_ to the browser — anything without that prefix is silently undefined.

# Same Supabase project the slashloop MCP server (man0l/slashloop) uses —
# this is what makes a session here valid on the MCP's billing routes.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed MCP server (man0l/slashloop), no trailing slash.
# Its /api/billing/checkout|portal|status routes back this site's pricing,
# account, and billing/success pages.
VITE_MCP_URL=https://slashloop-connector-seven.vercel.app
